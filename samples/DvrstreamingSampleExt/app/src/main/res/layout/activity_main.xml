<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            app:title="DvrStreaming External Player"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"/>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:id="@+id/dvrContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/dvrStartEndContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="6dp"
                    android:layout_height="match_parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#efefef"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/dvrStartTimeLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/dvrStartDivider"
                            android:textColor="@color/black"
                            android:text="DVR Start Time(the earliest time you can jump into the past of the stream)"/>

                        <Space
                            android:id="@+id/dvrStartDivider"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            app:layout_constraintTop_toBottomOf="@+id/dvrStartTimeLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/dvrStartTimestamp"/>

                        <TextView
                            android:id="@+id/dvrStartTimestamp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/black"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/dvrStartDateTime"
                            app:layout_constraintTop_toBottomOf="@+id/dvrStartDivider"
                            tools:text="1234567890"/>
                        <TextView
                            android:id="@+id/dvrStartDateTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/dvrStartTimestamp"
                            tools:text="23/07 07:25:02"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="match_parent"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="6dp"
                    android:layout_height="match_parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#efefef"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/dvrEndTimeLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/dvrEndDivider"
                            android:text="DVR End Time(the latest time you can jump into the past of the stream)"/>
                        <Space
                            android:id="@+id/dvrEndDivider"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            app:layout_constraintTop_toBottomOf="@+id/dvrEndTimeLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/dvrEndTimestamp"/>
                        <TextView
                            android:id="@+id/dvrEndTimestamp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:textColor="@color/black"
                            app:layout_constraintBottom_toTopOf="@+id/dvrEndDateTime"
                            app:layout_constraintTop_toBottomOf="@+id/dvrEndDivider"
                            tools:text="1234567890"/>
                        <TextView
                            android:id="@+id/dvrEndDateTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/dvrEndTimestamp"
                            tools:text="23/07 07:25:02"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="6dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#efefef"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/dvrBufferLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/dvrBufferDivider"
                        android:text="DVR Buffer Size(how much can you perform DVR in the past)"/>
                    <Space
                        android:id="@+id/dvrBufferDivider"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toBottomOf="@+id/dvrBufferLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/dvrBufferTimestamp"/>
                    <TextView
                        android:id="@+id/dvrBufferTimestamp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/dvrBufferTime"
                        app:layout_constraintTop_toBottomOf="@+id/dvrBufferDivider"
                        tools:text="1234567890"/>
                    <TextView
                        android:id="@+id/dvrBufferTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/dvrBufferTimestamp"
                        tools:text="7h 25m"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#efefef"
                    android:padding="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/dvrPlayLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/dvrPlayTimestamp"
                        android:text="DVR Play (a DVR enabled stream supports playing from a specific timestamp between START and LATEST)"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dvrPlayTimestamp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="4dp"
                        app:boxBackgroundColor="@android:color/white"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/dvrPlayLabel"
                        android:enabled="false">
                        <com.google.android.material.textfield.TextInputEditText
                            android:inputType="number"
                            android:imeOptions="actionDone"
                            android:textAlignment="textEnd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/dvrPlaySlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:labelBehavior="floating"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:enabled="false"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dvrPlayAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="6dp"
                        android:enabled="false"
                        android:textAllCaps="false"
                        android:text="Play from timestamp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/refresh_metadata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="6dp"
                        android:enabled="false"
                        android:textAllCaps="false"
                        android:text="Refresh metadata in"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#efefef"
                    android:padding="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/dvrPlayShowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/dvrPlayTimestamp"
                        android:text="DVR Play Predefined Moments (Each button plays a different timestamp from the DVR window available)"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dvrPlay0"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            app:cornerRadius="6dp"
                            android:enabled="false"
                            android:textAllCaps="false"
                            android:text="0%"/>
                        <Space
                            android:layout_width="4dp"
                            android:layout_height="match_parent"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dvrPlay25"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            app:cornerRadius="6dp"
                            android:enabled="false"
                            android:textAllCaps="false"
                            android:text="25%"/>
                        <Space
                            android:layout_width="4dp"
                            android:layout_height="match_parent"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dvrPlay50"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            app:cornerRadius="6dp"
                            android:enabled="false"
                            android:textAllCaps="false"
                            android:text="50%"/>
                        <Space
                            android:layout_width="4dp"
                            android:layout_height="match_parent"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dvrPlay75"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            app:cornerRadius="6dp"
                            android:enabled="false"
                            android:textAllCaps="false"
                            android:text="75%"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#efefef"
                    android:padding="8dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPlay"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        app:cornerRadius="6dp"
                        android:textAllCaps="false"
                        app:icon="@android:drawable/ic_media_play"
                        app:iconGravity="textStart"
                        android:text="Play"/>
                    <Space
                        android:layout_width="4dp"
                        android:layout_height="match_parent"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonReset"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        app:icon="@android:drawable/ic_menu_revert"
                        app:cornerRadius="6dp"
                        app:iconGravity="textStart"
                        android:enabled="false"
                        android:textAllCaps="false"
                        android:text="Reset"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>