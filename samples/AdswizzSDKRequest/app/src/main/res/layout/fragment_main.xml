<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:context=".FirstFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Request type"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnClientside"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:text="Client"/>

                <Button
                    android:id="@+id/btnServerside"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:text="Streaming"/>

                <Button
                    android:id="@+id/btnPodcasting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:text="Podcasting"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:text="Url"/>

            <EditText
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:background="@drawable/custom_edit_text_background"
                android:layout_height="40dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:text="Location"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_frame"
                android:padding="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/location"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/custom_edit_text_background" />
                    <Button
                        android:id="@+id/btnSelectLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Select"/>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:text="SDK settings"/>

            <FrameLayout
                android:id="@+id/sdk_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_frame"
                android:padding="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="10dp"
                        android:text="SDK version"/>
                    <EditText
                        android:id="@+id/sdk_version"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_margin="4dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:background="@drawable/custom_edit_text_background"
                        android:hint="sdk version" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="10dp"
                        android:text="player id"/>
                    <EditText
                        android:id="@+id/player_id"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_margin="4dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:background="@drawable/custom_edit_text_background"
                        android:hint="player_id" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="10dp"
                        android:text="session id"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/session_id"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:background="@drawable/custom_edit_text_background"
                            android:hint="session id"
                            android:layout_margin="4dp"
                            android:layout_height="40dp"/>
                        <Button
                            android:id="@+id/btnRegenSessId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Regenerate"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="10dp"
                        android:text="if type"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <EditText
                                android:id="@+id/ifa"
                                android:layout_width="match_parent"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:background="@drawable/custom_edit_text_background"
                                android:hint="ifa (ifa type)"
                                android:layout_margin="4dp"
                                android:layout_height="40dp"/>
                            <TextView
                                android:id="@+id/ifatype"
                                android:layout_width="match_parent"
                                android:layout_marginLeft="4dp"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <Button
                            android:id="@+id/btnCycle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="Cycle"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/client_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:text="Client side settings"/>

            <FrameLayout
                android:id="@+id/client_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/rounded_frame"
                android:padding="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/client_zone_id"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:inputType="number"
                            android:background="@drawable/custom_edit_text_background"
                            android:hint="zone id" />

                        <EditText
                            android:id="@+id/client_max_ads"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_margin="5dp"
                            android:layout_weight="0.5"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:inputType="number"
                            android:background="@drawable/custom_edit_text_background"
                            android:hint="max ads" />

                        <EditText
                            android:id="@+id/client_max_duration"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_margin="5dp"
                            android:layout_weight="0.5"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:inputType="number"
                            android:background="@drawable/custom_edit_text_background"
                            android:hint="max dur" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/client_companion_zone"
                        android:layout_width="match_parent"
                        android:background="@drawable/custom_edit_text_background"
                        android:hint="companion zone"
                        android:inputType="number"
                        android:layout_margin="4dp"
                        android:layout_height="40dp"/>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/afr_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:text="Afr request settings"/>

            <FrameLayout
                android:id="@+id/afr_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/rounded_frame"
                android:padding="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/afr_url"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:background="@drawable/custom_edit_text_background"
                        android:hint="afr url" />

                    <EditText
                        android:id="@+id/afr_companion_zoneid"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_margin="5dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:background="@drawable/custom_edit_text_background"
                        android:hint="afr companion zone" />

                    <RadioGroup
                        android:id="@+id/afrProtocol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="25dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="25dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/btnHttp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="HTTP" />

                        <RadioButton
                            android:id="@+id/btnHttps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="HTTPS" />
                    </RadioGroup>

                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:text="Permissions"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_frame"
                android:padding="10dp">
                <RadioGroup
                    android:id="@+id/permissionGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="25dp"

                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/btn_permission_none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="No permission" />

                    <RadioButton
                        android:id="@+id/btn_microphone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Microphone" />

                    <RadioButton
                        android:id="@+id/btn_app_permission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="App permision" />

                </RadioGroup>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:text="Capabilities"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_frame"
                android:padding="10dp">
                <RadioGroup
                    android:id="@+id/capabilitiesGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="25dp"

                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/btn_audio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="Audio only" />

                    <RadioButton
                        android:id="@+id/btn_calendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Calendar" />

                    <RadioButton
                        android:id="@+id/btn_call"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Call" />

                    <RadioButton
                        android:id="@+id/btn_tap_tap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tap tap" />

                    <RadioButton
                        android:id="@+id/btn_watch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Watch capability" />
                </RadioGroup>
            </FrameLayout>



        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnRequest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Make request"/>
</LinearLayout>