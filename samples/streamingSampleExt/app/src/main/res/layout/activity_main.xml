<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ffffff">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.Samples.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/Theme.Samples.PopupOverlay" />
    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:id="@+id/sdkVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AdsWizzSDK v7.2.30"
        android:textAlignment="viewStart"
        android:layout_marginTop="10dp"
        android:textColor="#434343"
        android:layout_marginLeft="10dp"
        app:layout_anchorGravity="top" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="6dp">
        <FrameLayout
        android:id="@+id/companionContainer"
        android:layout_width="match_parent"
        android:layout_height="300dp">

            <TextView
                android:gravity="center"
                android:textSize="18sp"
                android:layout_gravity="center"
                android:text="Companion Placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.ad.core.companion.AdCompanionView
                android:id="@+id/companionView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#efefef" />

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/appLogsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="@string/app_logs"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/companionContainer" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        android:layout_weight="1"
        app:cardCornerRadius="6dp">
    <TextView
        android:id="@+id/appLogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:scrollbars="vertical"
        android:textSize="14sp"
        android:background="#efefef" />
    </androidx.cardview.widget.CardView>
</LinearLayout>